# TickTick MCP Server Configuration
# Copy this file to .env and fill in your values.
# Run `node build/index.js auth` to set up automatically.

# ── V1 API (OAuth2) ──────────────────────────────────────
# Create an app at https://developer.ticktick.com/manage
TICKTICK_CLIENT_ID=your_client_id_here
TICKTICK_CLIENT_SECRET=your_client_secret_here
TICKTICK_ACCESS_TOKEN=your_access_token_here
TICKTICK_REFRESH_TOKEN=your_refresh_token_here

# ── V2 API (Session) ─────────────────────────────────────
# Your TickTick login credentials (enables tags, habits, focus, etc.)
TICKTICK_USERNAME=your_email@example.com
TICKTICK_PASSWORD=your_password_here
# Stable device id sent in the V2 `x-device` header. REQUIRED for V2 login:
# TickTick rejects signon from an empty/unknown device id with a misleading
# "username_password_not_match" error. Use any stable 24-char hex string, or
# the device id your TickTick web client uses (localStorage `deviceAnalyticsData.id`).
TICKTICK_DEVICE_ID=

# ── Host ──────────────────────────────────────────────────
# Use "ticktick" for international or "dida365" for China
TICKTICK_HOST=ticktick
